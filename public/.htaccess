<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Si el archivo o directorio existe, sirve normalmente
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Si no existe, redirige todo a index.html
  RewriteRule . /index.html [L]
</IfModule>

# =================================================================================
# HEADERS DE SEGURIDAD
# =================================================================================

<IfModule mod_headers.c>
  # Content Security Policy (CSP)
  # Controla qué recursos pueden cargarse en la página
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://analytics.tiktok.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' https://dermicapro.com https://dermicapro-kf6b9mxf2-alan-geronimos-projects.vercel.app https://dermica-pro-n8n.rcsgeg.easypanel.host https://n8n.dermicapro.online https://www.facebook.com; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'none';"

  # Prevenir Clickjacking
  # Impide que el sitio sea embebido en iframes
  Header always set X-Frame-Options "DENY"

  # Prevenir MIME Sniffing
  # Fuerza al navegador a respetar el Content-Type declarado
  Header always set X-Content-Type-Options "nosniff"

  # XSS Protection (navegadores legacy)
  # Activa filtro anti-XSS del navegador
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer Policy
  # Controla qué información de referencia se envía
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy (antes Feature-Policy)
  # Deshabilita APIs que no se usan
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # HSTS (HTTP Strict Transport Security)
  # Fuerza HTTPS por 1 año (solo si tienes SSL configurado)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
# =================================================================================
# Variables de Entorno - DermicaPro
# =================================================================================
# Este archivo documenta las variables de entorno necesarias para el proyecto.
#
# INSTRUCCIONES:
# 1. Copia este archivo como `.env.local` para desarrollo local
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NUNCA commits .env.local al repositorio (está en .gitignore)
# 4. Configura estas mismas variables en Vercel Dashboard para producción
# =================================================================================

# Google Gemini AI API Key
# Obtener en: https://makersuite.google.com/app/apikey
# Usado por: /api/gemini-proxy.js (Asesor Virtual de Piel)
GEMINI_API_KEY=tu_api_key_aqui

# Vercel (auto-generado por Vercel CLI)
# No modificar manualmente
VERCEL_OIDC_TOKEN=auto_generated
